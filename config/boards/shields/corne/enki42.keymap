#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/unicode.dtsi>
#include <zmk-unicode/keys-extra.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3
#define GME 4

&lt { quick_tap_ms = <220>; };
&mt { quick_tap_ms = <220>; };

/ {
    behaviors {
		hml: homerow_mods_left {
			compatible = "zmk,behavior-hold-tap";
			label = "HOMEROW_MODS_LEFT";
			#binding-cells = <2>;
			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			bindings = <&kp>, <&kp>;
			hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
		};

		hmr: homerow_mods_right {
			compatible = "zmk,behavior-hold-tap";
			label = "HOMEROW_MODS_RIGHT";
			#binding-cells = <2>;
			flavor = "balanced";
			tapping-term-ms = <280>;
			quick-tap-ms = <175>;
			require-prior-idle-ms = <150>;
			bindings = <&kp>, <&kp>;
			hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
		};
	};

};

&uc {
  default-mode = <UC_MODE_LINUX>;  // Default to Linux input system
  minimum-length = <0>;            // Set to desired minimum input length
  linux-key = <LC(LS(U))>;         // Overwrite Linux compose key
  win-compose-key = <RALT>;        // Overwrite WinCompose compose key
};

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default";
// ------------------------------------------------------------------------------------------------
//| LGUI/] |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | RGUI/[ | 
//| CTRL/` |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | CTRL/' |
//| LALT/\ |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | RALT/- |
//                             | RSE | SPC | LWR |   | LWR | BKSP | RSE |
                        bindings = <
  &mt LGUI RBKT   &kp Q &kp W &kp E &kp R &kp T               &kp Y  &kp U  &kp I     &kp O   &kp P    &mt RGUI LBKT 
  &kp GRAVE &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G  &kp H &hmr RSHFT J  &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
  &kp BSLH  &kp Z &kp X &kp C &kp V &kp B               &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp MINUS
        &lt RSE TAB &kp SPACE &lt LWR RET              &lt LWR ESC &kp BSPC &lt RSE DEL
                        >;
                };

                lower_layer {
                        display-name = "Number";
// -----------------------------------------------------------------------------------------
//|LGUI/CAPS |  *  |  7 |  8  |  9  |  +  |    |  !  |  @  |  #  |  $  |  %  | RGUI/F1 |
//|CTRL/MENU |  /  |  4 |  5  |  6  |  -  |    |  ^  |  &  |  *  |  (  |  )  | CTRL/F2 |
//|  LALT/=  |  0  |  1 |  4  |  3  |  .  |    |  ls |  F4 |  F5 |  F6 |  F7 | RALT/F3 |
//                      | ADJ | ___ | ___ |    | ___ | ___ | ADJ |
                        bindings = <
 &mt LGUI CAPS   &kp KP_MULTIPLY  &kp N7 &kp N8   &kp N9      &kp PLUS                    &kp EXCL      &kp AT    &kp HASH   &kp DLLR  &kp PRCNT &mt RGUI F1  
 &mt LCTRL K_APP &kp KP_SLASH     &kp N4 &kp N5   &kp N6      &kp MINUS                   &kp CARET     &kp AMPS  &kp STAR   &kp LPAR  &kp RPAR  &mt RCTRL F2
 &mt LALT EQUAL  &kp N0           &kp N1 &kp N2   &kp N3      &kp DOT                     &kp LG(SPACE) &kp F4    &kp F5     &kp F6    &kp F7    &mt RALT F3
                                                  &lt ADJ TAB &trans &trans        &trans &trans        &lt ADJ DEL
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
//| LGUI |  VOLU  |  PGUP  | PLAY | HOME | ___  |            | ___  | HOME | PLAY| PGUP | VOLU | RGUI |
//| CTRL |  VOLD  |  LEFT  |  UP  | DOWN | RGHT |            | LEFT | DOWN | UP  | RGHT | VOLD | CTRL | 
//| LALT |  MUTE  |  PGDN  |  ___ | END  | ___  |            | ___  | END  | ___ | PGDN | MUTE | RALT |
//                          | ___ | ___  | ADJ  |            | ADJ  | ___  | ___ |
                        bindings = <
&kp LGUI &kp C_VOL_UP &kp PG_UP &kp C_PP &kp HOME &none      
&none &kp HOME &kp C_PP &kp PG_UP &kp C_VOL_UP &kp RGUI

&kp LCTRL &kp C_VOL_DN &kp LEFT &kp UP &kp DOWN &kp RIGHT
&kp LEFT &kp DOWN &kp UP &kp RIGHT  &kp C_VOL_DN  &kp RCTRL 

&kp LALT &kp C_MUTE &kp PG_DN &none &kp END &none
&none &kp END &none &kp PG_DN &kp C_MUTE &kp RALT

&trans &trans &lt ADJ RET
&lt ADJ ESC &trans &trans
                        >; 
                };

                adjust_layer {
                        display-name = "Adjust";
// -----------------------------------------------------------------------------------------
//| BLDR | RGB | RGB | RGB | RGB | RGB |   | RGB | RGB | RGB | RGB | RGB | BLDR |
//| BTCLR| BT0 | BT1 | BT2 | BT3 | BT4 |   | BT4 | BT3 | BT2 | BT1 | BT0 | BTCLR|
//|pwrOFF|NUMLK|     |     |     |     |   |     |     |     |     |     |      |
//                   |     |     |     |   |     |     |     |
                        bindings = <
&bootloader &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF &rgb_ug RGB_SPI &rgb_ug RGB_SPD &bootloader
&none &none &none &mkp RCLK &mkp LCLK &mkp MCLK      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none &none
&ext_power EP_TOG &kp KP_NUM &none &none &none &none    &uc UC_DE_AE &uc UC_DE_OE &uc UC_DE_UE &uc UC_DE_SS &none &none
                                                              &trans &none &trans           &trans &none &trans
                        >;
                };

                gaming_layer {
                        display-name = "Gaming";
// -----------------------------------------------------------------------------------------
//| BLDR | RGB | RGB | RGB | RGB | RGB |   | RGB | RGB | RGB | RGB | RGB | BLDR |
//| BTCLR| BT0 | BT1 | BT2 | BT3 | BT4 |   | BT4 | BT3 | BT2 | BT1 | BT0 | BTCLR|
//|pwrOFF|NUMLK|     |     |     |     |   |     |     |     |     |     |      |
//                   |     |     |     |   |     |     |     |
                        bindings = <
&bootloader &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF &rgb_ug RGB_SPI &rgb_ug RGB_SPD &bootloader
&none &none &none &mkp RCLK &mkp LCLK &mkp MCLK      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none &none
&ext_power EP_TOG &kp KP_NUM &none &none &none &none    &uc UC_DE_AE &uc UC_DE_OE &uc UC_DE_UE &uc UC_DE_SS &none &none
                                                              &trans &none &trans           &trans &none &trans
                        >;
                };
        };
};
